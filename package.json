{
  "name": "typescript-api-health-monitor",
  "version": "1.0.0",
  "description": "Monitor API endpoints, record response times, detect failures, and display uptime reports with typed configuration.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["api", "monitor", "health", "uptime", "typescript"],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^1.5.0",
    "vite": "^5.2.0"
  }
}